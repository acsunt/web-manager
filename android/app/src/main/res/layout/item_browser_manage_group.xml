<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/manageGroupRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <ImageButton
        android:id="@+id/manageGroupHandle"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@android:color/transparent"
        android:contentDescription="拖拽分组"
        android:padding="6dp"
        android:src="@drawable/ic_browser_drag" />

    <TextView
        android:id="@+id/manageGroupTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:textColor="@color/browser_text"
        android:textIsSelectable="false"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/manageGroupRename"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="改名"
        android:textColor="@color/browser_accent"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/manageGroupDelete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="删除"
        android:textColor="@color/browser_danger"
        android:textSize="14sp" />
</LinearLayout>
