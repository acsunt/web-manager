<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sheetGroupHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="44dp"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="4dp">

    <ImageButton
        android:id="@+id/sheetGroupHandle"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@android:color/transparent"
        android:contentDescription="拖拽分组"
        android:padding="4dp"
        android:src="@drawable/ic_browser_drag" />

    <TextView
        android:id="@+id/sheetGroupTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/browser_text"
        android:textIsSelectable="false"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/sheetGroupRename"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="改名"
        android:textColor="@color/browser_accent"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/sheetGroupDelete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="删除"
        android:textColor="@color/browser_danger"
        android:textSize="13sp" />
</LinearLayout>
