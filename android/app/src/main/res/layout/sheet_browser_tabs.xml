<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_js_dialog"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sheetHeading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="打开的网页"
            android:textColor="@color/browser_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sheetManageGroups"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="4dp"
            android:drawableStart="@drawable/ic_browser_groups"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="0dp"
            android:paddingBottom="4dp"
            android:text="分组管理"
            android:textColor="@color/browser_accent"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">

        <EditText
            android:id="@+id/sheetSearch"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_js_dialog_input"
            android:hint="搜索名称或网址"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingStart="12dp"
            android:paddingEnd="40dp"
            android:singleLine="true"
            android:textColor="@color/browser_text"
            android:textColorHint="@color/browser_text_muted"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/sheetSearchClear"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="2dp"
            android:background="@android:color/transparent"
            android:contentDescription="清空搜索"
            android:padding="8dp"
            android:src="@drawable/ic_browser_close"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/sheetBatchBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sheetSelectCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="已选 0"
            android:textColor="@color/browser_text_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/sheetCollapseAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="折叠"
            android:textColor="@color/browser_accent"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/sheetSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="全选"
            android:textColor="@color/browser_accent"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/sheetPinSelected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="置顶"
            android:textColor="@color/browser_accent"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/sheetMoveSelected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="移动"
            android:textColor="@color/browser_accent"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/sheetCloseSelected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="关闭"
            android:textColor="@color/browser_danger"
            android:textSize="14sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/sheetList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/sheetDone"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="完成"
        android:textColor="@color/browser_accent"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
