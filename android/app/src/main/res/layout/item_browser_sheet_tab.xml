<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/sheetTabRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">

        <ImageView
            android:id="@+id/sheetTabHandle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:clickable="false"
            android:contentDescription="排序状态"
            android:focusable="false"
            android:padding="4dp"
            android:src="@drawable/ic_browser_drag"
            android:visibility="gone" />

        <CheckBox
            android:id="@+id/sheetCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/sheetTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/browser_text"
                android:textIsSelectable="false"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sheetUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/browser_text_muted"
                android:textIsSelectable="false"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/sheetCopy"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@android:color/transparent"
            android:contentDescription="复制网址"
            android:padding="4dp"
            android:src="@drawable/ic_browser_copy" />

        <ImageButton
            android:id="@+id/sheetPin"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@android:color/transparent"
            android:contentDescription="置顶网页"
            android:padding="4dp"
            android:src="@drawable/ic_browser_pin" />

        <ImageButton
            android:id="@+id/sheetMove"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@android:color/transparent"
            android:contentDescription="移动到分组"
            android:padding="4dp"
            android:src="@drawable/ic_browser_move" />

        <ImageButton
            android:id="@+id/sheetClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@android:color/transparent"
            android:contentDescription="关闭网页"
            android:padding="4dp"
            android:src="@drawable/ic_browser_close" />

        <ImageButton
            android:id="@+id/sheetDelete"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@android:color/transparent"
            android:contentDescription="删除网页"
            android:padding="4dp"
            android:src="@drawable/ic_browser_delete" />
    </LinearLayout>

    <View
        android:id="@+id/sheetTabDropTop"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="top"
        android:background="@color/browser_accent"
        android:visibility="gone" />

    <View
        android:id="@+id/sheetTabDropBottom"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="bottom"
        android:background="@color/browser_accent"
        android:visibility="gone" />
</FrameLayout>
