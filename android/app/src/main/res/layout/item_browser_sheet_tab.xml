<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <CheckBox
        android:id="@+id/sheetCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/sheetTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/browser_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sheetUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/browser_text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/sheetMove"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@android:color/transparent"
        android:contentDescription="移动网页"
        android:padding="6dp"
        android:src="@drawable/ic_browser_move" />

    <ImageButton
        android:id="@+id/sheetClose"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@android:color/transparent"
        android:contentDescription="关闭网页"
        android:padding="6dp"
        android:src="@drawable/ic_browser_close" />
</LinearLayout>
