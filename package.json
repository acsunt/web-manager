{
  "name": "web-manager",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-single-html.js",
    "vendor": "node scripts/offline-vendor.js",
    "apk": "node scripts/build-apk.js",
    "apk:upload": "node scripts/upload-apk.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "version:check": "node scripts/check-version.mjs",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "esbuild": "^0.25.9",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.4"
  }
}
